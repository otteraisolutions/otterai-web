---
<form id="contact-form" class="contact-form">
	<div class="contact-form__group">
		<label for="name" class="contact-form__label text-lg font-semibold"
			>Nombre</label
		>
		<input
			type="text"
			id="name"
			name="name"
			required
			class="contact-form__input"
			placeholder="John Doe"
		/>
	</div>
	<div class="contact-form__group">
		<label for="email" class="contact-form__label text-lg font-semibold"
			>Correo Electrónico</label
		>
		<input
			type="email"
			id="email"
			name="email"
			required
			class="contact-form__input"
			placeholder="jhon@mail.com"
		/>
	</div>
	<div class="contact-form__group">
		<label for="phone" class="contact-form__label text-lg font-semibold"
			>Número Teléfono</label
		>
		<input
			type="tel"
			id="phone"
			name="phone"
			required
			class="contact-form__input"
			placeholder="+57 555 555 55 55"
		/>
	</div>
	<div class="contact-form__group">
		<label for="message" class="contact-form__label text-lg font-semibold"
			>Mensaje</label
		>
		<textarea
			id="message"
			name="message"
			rows="5"
			required
			class="contact-form__textarea"
			placeholder="Deja tu mensaje aquí..."></textarea>
	</div>
	<button
		type="submit"
		class="contact-form__submit btn btn-primary text-lg font-semibold"
	>
		Enviar Mensaje
	</button>
</form>
<style>
    .contact-form {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .contact-form__group {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .contact-form__input, .contact-form__textarea {
        width: 100%;
        padding: 0.5rem;
        border-radius: 0.375rem;
        font-size: 1rem;
        background-color: var(--color-primary-600);
        border: solid 1px transparent;
        transition: all 0.3s ease-in-out;
    }

    .contact-form__input:focus, .contact-form__textarea:focus {
        border: solid 1px var(--color-secondary-500);
        box-shadow: rgba(1, 218, 137, 0.4) 0px 0px 10px 2px;
    }

    .contact-form__input::placeholder, .contact-form__textarea::placeholder {
        opacity: 0.6;
    }

    /* ==== error styles ===== */
    .error-text {
        color: var(--color-error-100);
    }

    .contact-form__input--error,  .contact-form__textarea--error {
        border: solid 2px var(--color-error-100);
    }

    .contact-form__input--error::placeholder, .contact-form__textarea--error::placeholder {
        opacity: 0.6;
        color: var(--color-error-100);
    } 
</style>
<script src="/src/services/emailJs.ts">
</script>